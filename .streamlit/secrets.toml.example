# .streamlit/secrets.toml.example
# Este é um arquivo de exemplo. Copie para secrets.toml e preencha as senhas reias
# Não coloque as senhas reais e chaves de api neste arquivo.

[credentials]
usernames.salviana.name     = "Dra. Salviana Lima da Silva"
usernames.salviana.password = "$2b$12$..." # Senha gerada por hash bcrypt
usernames.salviana.role     = "advogada"

usernames.eryko.name        = "Eryko Costa (Dev)"
usernames.eryko.password    = "$2b$12$..."
usernames.eryko.role        = "admin"

usernames.secretaria.name   = "Secretaria do Escritório"
usernames.secretaria.password = "$2b$12$..."
usernames.secretaria.role   = "secretaria"

[cookie]
name       = "agente_securitario_auth"
key        = "chave_aleatoria_para_assinar_cookies"
expiry_days = 30

[api_keys]
anthropic = "sk-ant-..."
openai    = "sk-..."
gemini    = "AIza..."
